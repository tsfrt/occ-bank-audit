// Bank Audit Analyst UI - Prisma schema for Lakebase PostgreSQL
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditCaseStatus {
  pending_analysis
  pending_review
  reviewed
  manual_review
}

enum CaseReviewAction {
  reviewed
  dig_deeper
}

enum AuditType {
  meeting_minute_analysis
  bank_statement_analysis
  financial_document_analysis
  regulatory_compliance_review
  loan_portfolio_analysis
  transaction_monitoring
  internal_control_review
  liquidity_risk_assessment
}

model Auditor {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cases AuditCase[]

  @@map("auditors")
}

model AuditCase {
  id          String   @id @default(cuid())
  bankId      String   @map("bank_id")
  bankName    String?  @map("bank_name")
  reference   String?  // external reference
  auditType   AuditType? @map("audit_type") // set before analysis; drives model endpoint
  status      AuditCaseStatus @default(pending_analysis)
  riskScore   Float?   @map("risk_score")   // from latest analysis
  aiConfidence Float?  @map("ai_confidence") // 0-1 or 0-100 from latest analysis
  reviewedAt  DateTime? @map("reviewed_at")
  reviewedBy  String?  @map("reviewed_by")
  auditorId   String   @map("auditor_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  auditor              Auditor                @relation(fields: [auditorId], references: [id], onDelete: Restrict)
  analyses             CaseAnalysis[]
  reviews              CaseReview[]
  notifications        Notification[]
  handbookAuditMessages HandbookAuditMessage[]

  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([auditorId])
  @@map("audit_cases")
}

model CaseAnalysis {
  id              String    @id @default(cuid())
  caseId          String    @map("case_id")
  auditType       AuditType? @map("audit_type")  // audit type used for this run
  riskScore       Float     @map("risk_score")
  aiConfidence    Float     @map("ai_confidence") // 0-1 or 0-100
  modelEndpoint   String?   @map("model_endpoint")
  rawPayload      Json?     @map("raw_payload")   // full model response for audit
  completedAt     DateTime  @default(now()) @map("completed_at")

  case AuditCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_analyses")
}

model CaseReview {
  id        String           @id @default(cuid())
  caseId    String           @map("case_id")
  action    CaseReviewAction
  notes     String?
  reviewedBy String?         @map("reviewed_by")
  createdAt DateTime         @default(now()) @map("created_at")

  case AuditCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_reviews")
}

enum HandbookAuditDomain {
  bsa_aml
  loan_portfolio_management
  rating_credit_risk
  allowances_credit_losses
  corporate_risk_governance
  internal_external_audits
  liquidity
  interest_rate_risk
  capital_dividends
  commercial_real_estate
  commercial_loans
  residential_real_estate
  concentrations_of_credit
  leveraged_lending
  credit_card_lending
}

model HandbookAuditMessage {
  id        String               @id @default(cuid())
  caseId    String               @map("case_id")
  domain    HandbookAuditDomain
  role      String               // "user" or "assistant"
  content   String
  createdAt DateTime             @default(now()) @map("created_at")

  case AuditCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([caseId, domain])
  @@map("handbook_audit_messages")
}

enum NotificationType {
  case_assigned
  case_status_changed
}

model Notification {
  id         String           @id @default(cuid())
  recipientId String          @map("recipient_id")  // auditor identifier (e.g. email), matches reviewedBy
  caseId     String           @map("case_id")
  type       NotificationType
  title      String
  message    String?
  previousStatus String?      @map("previous_status")  // for status_change
  newStatus  String?          @map("new_status")
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now()) @map("created_at")

  case AuditCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, read])
  @@index([createdAt])
  @@map("notifications")
}
